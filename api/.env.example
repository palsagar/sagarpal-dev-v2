# Copy to api/.env for local overrides. Real environment variables take precedence.
# Phase 0 variables only. Phase 5 adds HASH_SECRET, SESSION_SECRET,
# ADMIN_PASSWORD_HASH, ADMIN_API_TOKEN, TRUST_CLOUDFLARE, UMAMI_DOMAIN and
# UMAMI_ID (see docs/redesign/API.md section 8).

# Absolute site origin used in RSS and OG URLs. Default: http://localhost:4321
SITE_URL=http://localhost:4321

# Astro build output served by the API. Default: <repo root>/web/dist
# STATIC_DIR=/app/web/dist

# SQLAlchemy URL. Default: sqlite:///<repo root>/.data/site.db
# Production: sqlite:////data/site.db (four slashes = absolute path)
# DATABASE_URL=sqlite:////data/site.db

# Log level. Default: info
LOG_LEVEL=info
