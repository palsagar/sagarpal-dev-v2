# Copy to api/.env for local development. Real environment variables take precedence.
# Full reference: docs/redesign/API.md section 8. Never commit real secrets.

# Absolute site origin used in RSS and OG URLs. Default: http://localhost:4321
SITE_URL=http://localhost:4321

# Astro build output served by the API. Default: <repo root>/web/dist
# STATIC_DIR=/app/web/dist

# SQLAlchemy URL. Default: sqlite:///<repo root>/.data/site.db
# Production: sqlite:////data/site.db (four slashes = absolute path)
# DATABASE_URL=sqlite:////data/site.db

# Required. At least 32 characters each. Generate with:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
# HASH_SECRET keys the daily visitor HMAC; SESSION_SECRET signs the admin cookie and CSRF tokens.
HASH_SECRET=
SESSION_SECRET=

# Required. argon2id hash of the admin password. Generate with:
#   uv run python -m app.tools.hash_password
# Wrap the value in single quotes: it contains "$".
ADMIN_PASSWORD_HASH=

# Optional. Enables the JSON admin API (Authorization: Bearer <token>). Empty = disabled.
ADMIN_API_TOKEN=

# Optional. true in production (behind Cloudflare): use CF-Connecting-IP. Default: false
TRUST_CLOUDFLARE=false

# Optional. Both set = the Umami tag is injected before </head>. No trailing slash.
UMAMI_DOMAIN=
UMAMI_ID=

# Optional. Contact address added to the User-Agent of Crossref, arXiv and Open Library
# lookups (Crossref asks for one). Empty = no address is sent.
CONTACT_EMAIL=

# Log level. Default: info
LOG_LEVEL=info
