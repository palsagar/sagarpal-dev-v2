# Only web/, api/ and deploy/ go into the build, without local builds, caches or secrets.
*
!web/
!api/
!deploy/

web/node_modules/
web/dist/
web/.astro/
web/tests/
web/test-results/
web/playwright-report/
web/blob-report/
api/.venv/
api/tests/
api/.env
api/.env.*
**/__pycache__/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/.DS_Store
