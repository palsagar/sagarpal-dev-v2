{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "url": [
        "https://next.sagar-pal.dev/",
        "https://next.sagar-pal.dev/projects/",
        "https://next.sagar-pal.dev/publications/",
        "https://next.sagar-pal.dev/blog/",
        "https://next.sagar-pal.dev/what-im-reading/"
      ]
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": [
              "error",
              { "minScore": 0.95, "aggregationMethod": "median-run" }
            ],
            "largest-contentful-paint": [
              "error",
              { "maxNumericValue": 2000, "aggregationMethod": "median-run" }
            ],
            "cumulative-layout-shift": [
              "error",
              { "maxNumericValue": 0.05, "aggregationMethod": "median-run" }
            ],
            "total-blocking-time": [
              "error",
              { "maxNumericValue": 150, "aggregationMethod": "median-run" }
            ]
          }
        },
        {
          "matchingUrlPattern": "^https://[^/]+/$",
          "assertions": {
            "resource-summary:script:size": [
              "error",
              { "maxNumericValue": 61440, "aggregationMethod": "median-run" }
            ]
          }
        }
      ]
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci/reports" }
  }
}
