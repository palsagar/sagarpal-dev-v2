---
// Paper rows (DESIGN.md §7.1.6): year, title, authors (Sagar bold) + journal,
// PDF pill when there is a PDF, then a DOI or arXiv pill. Pass papers already sorted.
// `full` (the /publications/ page) adds each paper's description.
import type { CollectionEntry } from 'astro:content';
import { doiLabel } from '../lib/format';

interface Props {
  papers: CollectionEntry<'publications'>[];
  full?: boolean;
}

const { papers, full = false } = Astro.props;
---

<ol reversed class="papers" role="list">
  {papers.map(({ data: p }) => (
    <li class="paper">
      <span class="paper__year tabular">{p.year}</span>
      <div class="paper__body">
        <span class="paper__title">{p.title}</span>
        {/* `authors` is repo-authored YAML; the only markup is <strong> around Sagar's name. */}
        <span class="paper__authors">
          <Fragment set:html={p.authors} />. {p.journal}.
        </span>
        {full && <p class="paper__description">{p.description}</p>}
        <div class="paper__links">
          {p.pdf && (
            <a class="btn btn--secondary btn--xs" href={p.pdf}>
              PDF
            </a>
          )}
          <a class="btn btn--secondary btn--xs" href={p.doi}>
            {doiLabel(p.doi)}
          </a>
        </div>
      </div>
    </li>
  ))}
</ol>

<style>
  .papers {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .paper {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 48px;
    padding: 28px 0;
  }

  .paper__year {
    flex: 0 0 7rem;
    font-size: 30px;
    font-weight: 500;
    line-height: 1.1;
    color: var(--ink-2);
  }

  .paper__body {
    flex: 1 1 520px;
    min-width: 0;
    max-width: 900px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .paper__title {
    font-size: clamp(21px, 1.8vw, 26px);
    font-weight: 560;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }

  .paper__authors {
    font-size: 16px;
    color: var(--ink-2);
  }

  .paper__authors :global(strong) {
    color: var(--ink);
    font-weight: 600;
  }

  .paper__description {
    max-width: 68ch;
    margin-top: 4px;
    font-size: 17px;
    line-height: 1.55;
  }

  .paper__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 6px;
  }

  .paper__links .btn {
    font-weight: 400;
  }

  @media (max-width: 719.98px) {
    .paper {
      padding: 20px 0;
    }

    .paper__year {
      font-size: 24px;
    }

    .paper__title {
      font-size: 20px;
    }
  }
</style>
