---
// Latest-posts rows on the home page (DESIGN.md §7.1.3): date | title + dek |
// reading time; on phones the reading time joins the date above the title.
// The blog collection arrives in Phase 4; until then the home page passes no posts.
export interface PostRow {
  href: string;
  title: string;
  dek: string;
  date: Date;
  readingMinutes: number;
}

interface Props {
  posts: PostRow[];
}

const { posts } = Astro.props;
const month = (d: Date) =>
  // en-US: "Sep 2026" (en-GB gives "Sept 2026").
  d.toLocaleDateString('en-US', {
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  });
---

<ul class="writing" role="list">
  {posts.map((post) => (
    <li>
      <a class="row-link writing__row" href={post.href}>
        <span class="writing__date tabular">
          <time datetime={post.date.toISOString().slice(0, 10)}>
            {month(post.date)}
          </time>
          <span class="phone-only">, {post.readingMinutes} min read</span>
        </span>
        <span class="writing__main">
          <span class="list-title row-link__title">{post.title}</span>
          <span class="writing__dek">{post.dek}</span>
        </span>
        <span class="writing__time phone-hidden">
          {post.readingMinutes} min read
        </span>
      </a>
    </li>
  ))}
</ul>

<style>
  .writing {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .writing__row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 48px;
  }

  .writing__date {
    flex: 0 0 7rem;
    padding-top: 8px;
    font-size: 16px;
    color: var(--ink-2);
  }

  .writing__main {
    flex: 1 1 440px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .writing__dek {
    max-width: 62ch;
    font-size: 18px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  .writing__time {
    flex: 0 0 auto;
    padding-top: 10px;
    font-size: 15px;
    color: var(--ink-2);
  }

  @media (max-width: 719.98px) {
    .writing {
      gap: 12px;
    }

    .writing__row {
      flex-direction: column;
      gap: 8px;
    }

    .writing__date {
      flex: none;
      padding-top: 0;
      font-size: 14px;
    }

    .writing__main {
      flex: none;
      gap: 8px;
    }

    .writing__dek {
      font-size: 16px;
    }
  }
</style>
