---
// An image with an optional day-theme variant (DESIGN.md §3.5): both pictures
// share one box and CSS shows the one for the active theme. Both are lazy, so
// the hidden one is never fetched.
// `priority` is for the first large image on a page (the LCP element): a
// single image loads eagerly with high priority; for a theme pair, an inline
// script preloads the active theme's AVIF, as the home hero does.
import type { ImageMetadata } from 'astro';
import { Picture, getImage } from 'astro:assets';

interface Props {
  src: ImageMetadata;
  srcDay?: ImageMetadata | undefined;
  /** Empty for decorative images. */
  alt: string;
  sizes: string;
  widths?: number[];
  class?: string;
  priority?: boolean;
}

const {
  src,
  srcDay,
  alt,
  sizes,
  widths = [480, 800, 1200, 1600],
  class: className,
  priority = false,
} = Astro.props;
const fits = (image: ImageMetadata) => widths.filter((w) => w <= image.width);
const variants = srcDay
  ? [
      { image: src, cls: 'only-night' },
      { image: srcDay, cls: 'only-day' },
    ]
  : [{ image: src, cls: '' }];
const eager = priority && !srcDay;

const avif = async (image: ImageMetadata) =>
  (await getImage({ src: image, widths: fits(image), format: 'avif' })).srcSet
    .attribute;
const preload =
  priority && srcDay
    ? { night: await avif(src), day: await avif(srcDay), sizes }
    : null;
---

{preload && <script is:inline define:vars={{ preload }}>
  const link = document.createElement('link');
  const theme =
    document.documentElement.dataset.theme === 'day' ? 'day' : 'night';
  link.rel = 'preload';
  link.as = 'image';
  link.type = 'image/avif';
  link.setAttribute('imagesrcset', preload[theme]);
  link.setAttribute('imagesizes', preload.sizes);
  link.setAttribute('fetchpriority', 'high');
  document.head.append(link);
</script>}
{variants.map(({ image, cls }) => (
  <Picture
    src={image}
    alt={alt}
    formats={['avif', 'webp']}
    widths={fits(image)}
    sizes={sizes}
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : undefined}
    decoding="async"
    class={className}
    pictureAttributes={{ class: cls || undefined }}
  />
))}
