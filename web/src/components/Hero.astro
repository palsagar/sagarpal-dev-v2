---
// Home hero (DESIGN.md §7.1.1). Desktop: text column + the field bleeding to the
// right edge. Phone: the field first, full-bleed, then the text.
// The poster is server-rendered and stays the LCP element. The live field
// (lib/hero-field.ts) loads after the page, fades in over it, and reveals the
// preset controls. Reduced motion or Data Saver: a "Play simulation" button
// instead. No JS or no WebGL2: the poster only.
import { elsewhere, site } from '../data/site';
import { PRESETS, fmt } from '../lib/field-presets';
import { POSTER_SIZES, heroPosters } from '../lib/hero-poster';

interface Props {
  /** With 0 published posts the primary CTA points at the projects instead. */
  hasPosts: boolean;
}

const { hasPosts } = Astro.props;
const posters = await heroPosters();
const primary = hasPosts
  ? { label: 'Read the writing', href: '/blog/' }
  : { label: 'View projects', href: '#work' };
const social = elsewhere.filter((link) => link.label !== 'RSS');
---

<section class="hero container" aria-labelledby="hero-title">
  <div class="hero__text">
    <div class="hero__intro">
      <h1 id="hero-title" class="display">
        {site.name}
      </h1>
      <p class="statement">
        I work at the intersection of scientific computing, AI for science and
        high-performance ML systems.
      </p>
      <div class="hero__ctas">
        <a class="btn btn--primary btn--lg" href={primary.href}>
          {primary.label}
        </a>
        <a class="btn btn--secondary btn--lg" href={site.cv}>
          Download CV
        </a>
      </div>
    </div>
    <ul class="hero__social phone-hidden" role="list">
      {social.map((link) => (
        <li>
          <a class="navlink" href={link.href}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  </div>

  <figure class="hero__field">
    <div class="hero__frame" data-hero-field data-state="idle">
      {(['night', 'day'] as const).map((theme) => (
        <picture class={`hero__poster only-${theme}`}>
          <source
            type="image/avif"
            srcset={posters[theme].avif}
            sizes={POSTER_SIZES}
          />
          <source
            type="image/webp"
            srcset={posters[theme].webp}
            sizes={POSTER_SIZES}
          />
          <img
            src={posters[theme].src}
            width={posters[theme].width}
            height={posters[theme].height}
            alt="Gray–Scott reaction–diffusion: coral-like colonies with teal rims and amber cores spreading across the field"
            loading="lazy"
            decoding="async"
          />
        </picture>
      ))}
      <canvas class="hero__canvas" aria-hidden="true"></canvas>
      <div class="hero__controls" hidden>
        <div class="hero__presets" role="group" aria-label="Pattern preset">
          {PRESETS.map((p, i) => (
            <button
              type="button"
              class="pill pill--ghost hero__preset"
              data-preset={p.id}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              {p.label}
            </button>
          ))}
        </div>
        <p class="hero__readout tabular phone-hidden">
          <span>
            F = <span data-readout-f>{fmt(PRESETS[0].F)}</span>
          </span>
          <span>
            k = <span data-readout-k>{fmt(PRESETS[0].k)}</span>
          </span>
        </p>
      </div>
      <button type="button" class="btn btn--primary btn--sm hero__play" hidden>
        Play simulation
      </button>
    </div>
    <figcaption>
      <span class="phone-hidden">
        Gray–Scott reaction–diffusion, solved live on your GPU. Drag across the
        field to seed new growth.
      </span>
      <span class="phone-only">
        Gray–Scott reaction–diffusion, live. Touch the field to seed growth.
      </span>
    </figcaption>
  </figure>
</section>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 48px;
  }

  .hero__text {
    flex: 1 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 64px;
    padding: 88px 0 8px;
  }

  .hero__intro {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero__social {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 15px;
  }

  .hero__field {
    flex: 1.15 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    margin-right: calc(-1 * var(--gutter));
  }

  .hero__frame {
    position: relative;
    height: clamp(440px, 54vw, 780px);
    overflow: hidden;
    background: var(--ground);
  }

  .hero__poster,
  .hero__poster img {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__poster img {
    object-fit: cover;
  }

  /* ---------- Live field (Phase 3) ---------- */

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
    touch-action: pan-y;
    cursor: crosshair;
    transition: opacity 400ms var(--ease-out);
  }

  .hero__frame[data-ready] .hero__canvas {
    opacity: 1;
    pointer-events: auto;
  }

  .hero__controls {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 16px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    pointer-events: none;
  }

  .hero__presets,
  .hero__readout {
    pointer-events: auto;
    border-radius: 999px;
    background: var(--ground);
  }

  .hero__presets {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 5px;
  }

  .hero__preset {
    height: 36px;
    padding: 0 16px;
    font-size: 14px;
  }

  .hero__readout {
    display: flex;
    align-items: center;
    gap: 18px;
    height: 46px;
    padding: 0 18px;
    font-size: 14px;
  }

  .hero__play {
    position: absolute;
    left: 16px;
    bottom: 16px;
  }

  .hero__field figcaption {
    padding: 14px var(--gutter) 0 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--ink-2);
  }

  /* Stacked (the two 520px columns no longer fit): the field bleeds on both sides. */
  @media (max-width: 1159.98px) {
    .hero__field {
      margin-left: calc(-1 * var(--gutter));
    }

    .hero__field figcaption {
      padding-left: var(--gutter);
    }
  }

  @media (max-width: 719.98px) {
    .hero {
      row-gap: 0;
    }

    .hero__field {
      order: -1;
      margin-top: 4px;
    }

    .hero__frame {
      height: 400px;
    }

    .hero__controls {
      left: 12px;
      right: 12px;
      bottom: 12px;
    }

    .hero__presets {
      flex-wrap: nowrap;
      max-width: 100%;
      padding: 4px;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .hero__preset {
      flex: 0 0 auto;
      height: 44px;
      padding: 0 14px;
    }

    .hero__play {
      left: 12px;
      bottom: 12px;
    }

    .hero__field figcaption {
      padding-top: 10px;
    }

    .hero__text {
      padding: 40px 0 0;
    }

    .hero__intro {
      gap: 24px;
    }

    .hero__intro .display {
      line-height: 0.88;
    }

    .hero__intro .statement {
      line-height: 1.35;
    }

    .hero__ctas {
      gap: 8px;
    }

    .hero__ctas .btn {
      flex: 1 1 auto;
      padding: 0 22px;
    }
  }
</style>

<script>
  // Loads the live field once the hero is on screen, after the page has loaded
  // and the browser is idle, so the poster stays the LCP element. Runs again
  // after each client-router navigation; cleans up before the next swap.
  let cleanup: (() => void) | undefined;

  const mount = async (root: HTMLElement, focusControls = false) => {
    const { mountHeroField } = await import('../lib/hero-field');
    if (root.isConnected)
      cleanup = await mountHeroField(root, { focusControls });
  };

  const whenIdle = (fn: () => void) => {
    const idle = () =>
      'requestIdleCallback' in window
        ? requestIdleCallback(fn, { timeout: 2000 })
        : setTimeout(fn, 200);
    if (document.readyState === 'complete') idle();
    else addEventListener('load', idle, { once: true });
  };

  document.addEventListener('astro:page-load', () => {
    const root = document.querySelector<HTMLElement>('[data-hero-field]');
    if (!root) return;
    if (!('WebGL2RenderingContext' in window)) {
      root.dataset.state = 'unsupported';
      return;
    }
    const saveData = (
      navigator as Navigator & { connection?: { saveData?: boolean } }
    ).connection?.saveData;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches || saveData) {
      const play = root.querySelector<HTMLButtonElement>('.hero__play')!;
      root.dataset.state = 'play';
      play.hidden = false;
      play.addEventListener(
        'click',
        () => {
          play.hidden = true;
          void mount(root, true);
        },
        { once: true },
      );
      return;
    }
    const io = new IntersectionObserver(([entry]) => {
      if (!entry?.isIntersecting) return;
      io.disconnect();
      // Lazy images do not hold back the load event: wait for the visible
      // poster itself, so the warm-up never competes with the LCP image.
      const poster = [...root.querySelectorAll('img')].find(
        (img) => img.offsetParent !== null,
      );
      const decoded = poster ? poster.decode().catch(() => {}) : null;
      void Promise.resolve(decoded).then(() =>
        whenIdle(() => void mount(root)),
      );
    });
    io.observe(root);
  });

  document.addEventListener('astro:before-swap', () => {
    cleanup?.();
    cleanup = undefined;
  });
</script>
