---
// <LiveField preset="mitosis" caption="…" /> in posts: a live Gray–Scott field
// with F and k sliders (Post.dc.html, Figure 2). Same engine and start rules as
// the hero (lib/field-runner.ts, lib/field-loader.ts): it starts once visible
// and idle; reduced motion or Save-Data shows a Play button; without JS, WebGL2
// or a hardware GPU the poster stays and the sliders stay hidden.
// `n` comes from remarkPostMeta in lib/markdown.ts.
import type { ImageMetadata } from 'astro';
import mitosisDay from '../../assets/fig-mitosis-day.jpg';
import mitosisNight from '../../assets/fig-mitosis-night.jpg';
import coralDay from '../../assets/field-hero-day.jpg';
import coralNight from '../../assets/field-hero-night.jpg';
import { PRESETS, fmt, type Preset } from '../../lib/field-presets';
import ThemedPicture from '../ThemedPicture.astro';

interface Props {
  preset?: Preset['id'];
  caption?: string;
  alt?: string;
  /** Still image for visitors without the live field. Defaults by preset. */
  poster?: ImageMetadata;
  posterDay?: ImageMetadata;
  n?: string;
}

const {
  preset = 'coral',
  caption,
  alt = 'A Gray–Scott reaction–diffusion pattern with teal rims and amber cores',
  n = '',
} = Astro.props;
const start = PRESETS.find((p) => p.id === preset) ?? PRESETS[0];
const [poster, posterDay] =
  Astro.props.poster !== undefined
    ? [Astro.props.poster, Astro.props.posterDay]
    : preset === 'mitosis'
      ? [mitosisNight, mitosisDay]
      : [coralNight, coralDay];
const sliders = [
  { param: 'F', label: 'Feed rate F', min: 0.01, max: 0.08, value: start.F },
  { param: 'k', label: 'Kill rate k', min: 0.045, max: 0.07, value: start.k },
];
const id = `live-field-${n}`;
---

<figure class="live-field">
  <div class="live-field__frame" data-live-field data-state="idle">
    <ThemedPicture
      src={poster}
      srcDay={posterDay}
      alt={alt}
      sizes="(min-width: 1024px) 760px, 100vw"
      class="live-field__poster"
    />
    <canvas class="live-field__canvas" aria-hidden="true"></canvas>
    <button
      type="button"
      class="btn btn--primary btn--sm live-field__play"
      hidden
    >
      Play simulation
    </button>
  </div>
  <div class="live-field__controls" hidden>
    {sliders.map((s) => (
      <div class="live-field__control">
        <label for={`${id}-${s.param}`}>
          <span>{s.label}</span>
          <output class="tabular" data-readout={s.param}>
            {fmt(s.value)}
          </output>
        </label>
        <input
          id={`${id}-${s.param}`}
          type="range"
          min={s.min}
          max={s.max}
          step="0.0001"
          value={s.value}
          data-param={s.param}
        />
      </div>
    ))}
  </div>
  {caption && (
    <figcaption>
      {n && <span>Figure {n}. </span>}
      {caption}
    </figcaption>
  )}
</figure>

<script>
  // Starts each live field when wanted (lib/field-loader.ts); the engine and
  // slider wiring load on demand. Cleans up before each client-router swap.
  import { watchField } from '../../lib/field-loader';

  let cleanups: (() => void)[] = [];

  document.addEventListener('astro:page-load', () => {
    for (const root of document.querySelectorAll<HTMLElement>(
      '[data-live-field]',
    )) {
      const play = root.querySelector<HTMLButtonElement>('.live-field__play')!;
      const unwatch = watchField(root, play, async (fromPlay) => {
        const { mountLiveField } = await import('../../lib/live-field');
        if (root.isConnected)
          cleanups.push(
            await mountLiveField(root, { focusControls: fromPlay }),
          );
      });
      cleanups.push(unwatch);
    }
  });

  document.addEventListener('astro:before-swap', () => {
    cleanups.forEach((fn) => fn());
    cleanups = [];
  });
</script>

<style>
  .live-field {
    max-width: 760px;
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-family: var(--font-sans);
  }

  .live-field__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: 16px;
    background: var(--surface);
  }

  .live-field__frame :global(.live-field__poster) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .live-field__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    touch-action: pan-y;
    cursor: crosshair;
  }

  [data-ready] .live-field__canvas {
    opacity: 1;
  }

  @media (prefers-reduced-motion: no-preference) {
    .live-field__canvas {
      transition: opacity 400ms ease;
    }
  }

  .live-field__play {
    position: absolute;
    left: 16px;
    bottom: 16px;
  }

  .live-field__controls {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 32px;
  }

  .live-field__control {
    flex: 1 1 240px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .live-field__control label {
    display: flex;
    justify-content: space-between;
    font-size: 15px;
  }

  .live-field__control output {
    color: var(--ink-2);
  }

  .live-field__control input {
    width: 100%;
    height: 44px;
    margin: 0;
    accent-color: var(--link);
  }

  figcaption {
    font-size: 15px;
    line-height: 1.5;
    color: var(--ink-2);
  }
</style>
