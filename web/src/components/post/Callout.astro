---
// <Callout title="…"> in posts (DESIGN.md §6): a tone-step surface, no left
// border, no icon.
interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<aside class="callout">
  {title && <strong class="callout__title">{title}</strong>}
  <div class="callout__body">
    <slot />
  </div>
</aside>

<style>
  .callout {
    max-width: var(--measure);
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 24px 28px;
    border-radius: 16px;
    background: var(--surface);
    font-family: var(--font-sans);
    font-size: 17px;
    line-height: 1.55;
  }

  .callout__title {
    font-size: 18px;
    font-weight: 620;
  }

  .callout__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  @media (max-width: 719.98px) {
    .callout {
      padding: 20px;
    }
  }
</style>
